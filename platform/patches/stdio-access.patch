+/// Check Unix descriptor access without consuming input or emitting output.
+/// Rust standard streams intentionally hide EBADF; the platform must preserve
+/// it for callers that distinguish a real I/O error from EOF or a successful write.
+fn ensure_standard_stream_access(fd: i32, writing: bool) -> io::Result<()> {
+    #[cfg(unix)]
+    {
+        // SAFETY: F_GETFL only queries the descriptor and takes no third argument.
+        let flags = unsafe { libc::fcntl(fd, libc::F_GETFL) };
+        if flags == -1 {
+            return Err(io::Error::last_os_error());
+        }
+        let access = flags & libc::O_ACCMODE;
+        if (writing && access == libc::O_RDONLY) || (!writing && access == libc::O_WRONLY) {
+            return Err(io::Error::from_raw_os_error(libc::EBADF));
+        }
+    }
+    #[cfg(not(unix))]
+    let _ = (fd, writing);
+    Ok(())
+}
+
+/// Preserve empty-write no-ops while validating every nonempty output request.
+fn ensure_standard_output_access(fd: i32, bytes: &[u8]) -> io::Result<()> {
+    if bytes.is_empty() {
+        Ok(())
+    } else {
+        ensure_standard_stream_access(fd, true)
+    }
+}
